local Cycle=require("../src/shared/DoorCycle")
local count=0
--- Runs one behavior test and records its outcome.
local function test(name,callback) callback();count+=1;print("PASS",name) end
--- Creates a fully opened cycle at a deterministic time.
local function opened()
    local cycle=Cycle.new(1,2,18)
    cycle:Open(0);cycle:Step(1,false);cycle:Step(3,false)
    assert(cycle.state=="Open" and cycle.released)
    return cycle
end
test("signal and full opening precede release",function()
    local cycle=Cycle.new(1,2,18)
    assert(Cycle.CanWrite(cycle.state))
    cycle:Open(0);assert(cycle.state=="Signalling" and not cycle.released)
    cycle:Step(.9,false);assert(cycle.state=="Signalling")
    cycle:Step(1,false);assert(cycle.state=="Opening" and not cycle.released)
    cycle:Step(3,false);assert(cycle.state=="Open" and cycle.released)
end)
test("door closes and allows a new full exercise",function()
    local cycle=opened()
    cycle:Step(20,false);assert(cycle.state=="Open")
    cycle:Step(21,false);assert(cycle.state=="Closing")
    cycle:Step(23,false);assert(Cycle.CanWrite(cycle.state) and cycle.released)
    cycle:Open(24);assert(cycle.state=="Signalling")
    cycle:Step(25,false);cycle:Step(27,false);assert(cycle.state=="Open")
end)
test("occupancy postpones automatic closing indefinitely",function()
    local cycle=opened()
    cycle:Step(100,true);assert(cycle.state=="Open")
    cycle:Step(200,true);assert(cycle.state=="Open")
    cycle:Step(201,false);assert(cycle.state=="Closing")
end)
test("entering while closing reverses before sealing even at deadline",function()
    local cycle=opened();cycle:Step(21,false)
    cycle:Step(23,true);assert(cycle.state=="Opening")
    cycle:Step(25,false);assert(cycle.state=="Open" and cycle.deadline==43)
end)
test("duplicate opens do not restart an in-flight animation",function()
    local cycle=Cycle.new(1,2,18)
    cycle:Open(0);cycle:Open(.5);assert(cycle.deadline==1)
    cycle:Step(1,false);cycle:Open(2);assert(cycle.deadline==3)
end)
test("respawn can reopen a closed or closing door",function()
    local cycle=opened();cycle:Step(21,false);cycle:Open(22)
    assert(cycle.state=="Opening" and cycle.deadline==24)
    cycle:Step(24,false);cycle:Step(42,false);cycle:Step(44,false)
    cycle:Open(45);assert(cycle.state=="Signalling" and cycle.released)
end)
test("new sessions wait until fully closed",function()
    for _,state in ipairs({"Signalling","Opening","Open","Closing"}) do assert(not Cycle.CanWrite(state)) end
    assert(Cycle.CanWrite("Locked"));assert(Cycle.CanWrite("Closed"))
end)
print(count.." door cycle tests passed")