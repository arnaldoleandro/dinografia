local Metrics=require('../src/shared/WritingMetrics')
local passed=0
--- Runs one independent measurement regression.
local function test(name,fn) fn();passed+=1;print('PASS',name) end
--- Creates a horizontal guide and an explicitly controlled clock.
local function fixture()
 local now=0
 local meter=Metrics.new('T',{{a={x=0,y=.5},b={x=1,y=.5}}},function() return now end)
 return meter,function(value) now=value end
end
--- Compares floating point measurements within rounding noise.
local function equal(a,b) assert(math.abs(a-b)<.000001,tostring(a)..' ~= '..tostring(b)) end
test('first contact excludes camera setup and completed timing excludes server latency',function()
 local m,time=fixture();time(10);m:Contact('touch');m:Sample({x=.1,y=.5},true,0)
 time(11);m:Sample({x=.2,y=.5},true,.5)
 time(12);m:Sample({x=.3,y=.5},true,1);time(20)
 local result=m:Summary('completed');equal(result.seconds,2);equal(result.contactSeconds,2)
 equal(result.checkpoints['50'],1);equal(result.checkpoints['100'],2)
end)
test('contacts count physical presses and preserve pauses without bridging lifts',function()
 local m,time=fixture();m:Contact('mouse');m:Contact('mouse')
 m:Sample({x=.1,y=.5},true,0);time(1);m:Sample({x=.2,y=.5},true,.1);m:Lift()
 time(5);m:Contact('mouse');m:Sample({x=.8,y=.5},true,.1);time(6);m:Lift()
 local result=m:Summary('cancelled');assert(result.contacts==2);equal(result.seconds,6)
 equal(result.contactSeconds,2);equal(result.pathPanelWidths,.1)
end)
test('movement splits into advancing repeated and rejected distance',function()
 local m,time=fixture();m:Contact('touch');m:Sample({x=.1,y=.5},true,0)
 time(.1);m:Sample({x=.2,y=.5},true,.2)
 time(.2);m:Sample({x=.1,y=.5},true,.2)
 time(.3);m:Sample({x=.1,y=.6},false,.2)
 local result=m:Summary('cancelled');equal(result.advancingPath,.1);equal(result.repeatedPath,.1)
 equal(result.rejectedPath,.1);equal(result.movingWithoutAdvanceSeconds,.2)
 equal(result.meanGuideDistance,.1/3)
end)
test('meaningful reversals ignore small pointer jitter',function()
 local m,time=fixture();m:Contact('mouse');m:Sample({x=.1,y=.5},true,0)
 time(.1);m:Sample({x=.15,y=.5},true,.1)
 time(.2);m:Sample({x=.149,y=.5},true,.1)
 time(.3);m:Sample({x=.148,y=.5},true,.1)
 assert(m:Summary('cancelled').directionReversals==0)
 time(.4);m:Sample({x=.1,y=.5},true,.1)
 assert(m:Summary('cancelled').directionReversals==1)
end)
test('outside episodes do not count as extra contacts or connect distant points',function()
 local m=fixture();m:Contact('touch');m:Sample({x=.1,y=.5},true,0)
 m:Outside();m:Outside();m:Sample({x=.9,y=.5},true,0);m:Outside()
 local result=m:Summary('cancelled');assert(result.contacts==1 and result.panelExits==2)
 equal(result.pathPanelWidths,0)
end)
test('empty and independent attempts report no invented drawing time',function()
 local m,time=fixture();time(200);local result=m:Summary('restarted')
 equal(result.seconds,0);equal(result.contacts,0);equal(result.meanGuideDistance,0)
 local second=fixture();second:Contact('mouse');assert(m:Summary('cancelled').contacts==0)
end)
test('lifting after completion does not count server waiting as contact time',function()
 local m,time=fixture();m:Contact('touch');m:Sample({x=.1,y=.5},true,0)
 time(1);m:Lift();time(5);m:Contact('touch');m:Sample({x=.2,y=.5},true,.5)
 time(6);m:Sample({x=.3,y=.5},true,1);time(10);m:Lift()
 local result=m:Summary('completed');equal(result.seconds,6);equal(result.contactSeconds,2)
end)
print(passed..' writing metrics tests passed')
